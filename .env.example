# TriageAssist & Nearby Care Finder Configuration
# Copy this file to .env and adjust as necessary.
# Note: The app works 100% offline with zero API keys required out of the box using built-in seed facilities & OpenStreetMap!

# Optional: Google Places API Key (if using Google Places provider)
VITE_GOOGLE_MAPS_API_KEY=

# Optional: Geoapify API Key (if using Geoapify provider)
VITE_GEOAPIFY_API_KEY=

# Optional: Custom Overpass API endpoint (defaults to https://overpass-api.de/api/interpreter)
VITE_OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Optional: Backend API port (defaults to 3001)
PORT=3001

# Privacy Flag: Enable DPDP Act 2023 Strict Masking by default (true/false)
VITE_STRICT_DPDP_MASKING=true
